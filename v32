local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

-- Limpa chamadas antigas da memória
if CoreGui:FindFirstChild("PrismHubUI") then
    CoreGui.PrismHubUI:Destroy()
end

local Settings = {
    InfiniteReach = false,
    BringWood = false
}

-- Disparador Protegido (Previne o erro 'attempt to call a nil value')
local function SafeTriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            -- Verifica se a função nativa do executador existe antes de chamar
            if type(fireproximityprompt) == "function" then
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 999999
                fireproximityprompt(prompt)
            end
        end)
    end
end

-- LOOP DE COLETA E VENDA SEGURO
task.spawn(function()
    while task.wait(0.5) do
        if Settings.InfiniteReach then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.InfiniteReach then break end
                    if prompt:IsA("ProximityPrompt") then
                        local pName = prompt.Name:lower()
                        local parentName = (prompt.Parent and prompt.Parent.Name or ""):lower()
                        
                        if parentName:find("wood") or parentName:find("log") or parentName:find("tree") or pName:find("wood") or pName:find("sell") or parentName:find("sell") or pName:find("chipper") or parentName:find("chipper") then
                            SafeTriggerPrompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)

