-- [[ PRISM HUB v3.3 - SAFE TELEPORT FARM ]]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

-- Limpa interfaces antigas para evitar sobreposição
if CoreGui:FindFirstChild("PrismHubUI") then
    CoreGui.PrismHubUI:Destroy()
end

local Settings = {
    AutoFarmLoop = false,
    LoopDelay = 3 -- Pausa em segundos entre os ciclos
}

local CustomBaseCFrame = nil
local LastWoodCFrame = nil

-- Disparador seguro para a tecla "E"
local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            if typeof(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
            end
        end)
    end
end

-- CICLO PRINCIPAL (Coletar na floresta -> Teleportar para Base -> Vender -> Voltar)
task.spawn(function()
    while true do
        if Settings.AutoFarmLoop then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and CustomBaseCFrame then
                    -- ETAPA 1: Salva a posição atual onde está cortando madeira
                    LastWoodCFrame = hrp.CFrame

                    -- ETAPA 2: Coleta madeiras próximas por 3 segundos
                    local collectTimer = os.clock()
                    while os.clock() - collectTimer < 3 do
                        if not Settings.AutoFarmLoop then break end
                        for _, prompt in ipairs(Workspace:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                local parent = prompt.Parent
                                local parentName = parent and parent.Name or ""
                                if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or prompt.Name:find("Wood") then
                                    local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                                    if part and (part.Position - hrp.Position).Magnitude <= 20 then
                                        TriggerPrompt(prompt)
                                    end
                                end
                            end
                        end
                        task.wait(0.3)
                    end

                    -- ETAPA 3: Teleporta para a Base Salva e efetua a Venda
                    if Settings.AutoFarmLoop then
                        hrp.CFrame = CustomBaseCFrame + Vector3.new(0, 3, 0)
                        task.wait(0.5)

                        local sellTimer = os.clock()
                        while os.clock() - sellTimer < 2 do
                            if not Settings.AutoFarmLoop then break end
                            for _, prompt in ipairs(Workspace:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    local name = prompt.Name:lower()
                                    local pName = (prompt.Parent and prompt.Parent.Name or ""):lower()
                                    if name:find("sell") or pName:find("sell") or name:find("chipper") or pName:find("chipper") or name:find("saw") then
                                        TriggerPrompt(prompt)
                                    end
                                end
                            end
                            task.wait(0.3)
                        end
                    end

                    -- ETAPA 4: Retorna para o ponto de corte na floresta
                    if Settings.AutoFarmLoop and LastWoodCFrame then
                        hrp.CFrame = LastWoodCFrame
                    end
                end
            end)
        end
        task.wait(Settings.LoopDelay)
    end
end)

