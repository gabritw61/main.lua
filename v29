local Settings = {
    AutoCollect = false,
    AutoSell = false,
    AutoRollLever = false,
    NoClip = false
}

local CustomBaseCFrame = nil

local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- Sistema Inteligente de Localização de Base
local function GetMyBaseCFrame()
    -- Prioridade 1: Posição Manual Salva pelo Jogador
    if CustomBaseCFrame then
        return CustomBaseCFrame
    end

    -- Prioridade 2: Busca por Owner igual ao LocalPlayer em todo o Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Owner" or obj.Name == "OwnerValue" or obj.Name == "Player" then
            if obj:IsA("ObjectValue") and obj.Value == LocalPlayer then
                local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                if parentPart then return parentPart.CFrame end
            elseif obj:IsA("StringValue") and (obj.Value == LocalPlayer.Name or obj.Value == tostring(LocalPlayer.UserId)) then
                local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                if parentPart then return parentPart.CFrame end
            end
        end
    end

    -- Prioridade 3: Encontrar SpawnPad próximo
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        for _, spawn in ipairs(Workspace:GetDescendants()) do
            if spawn:IsA("SpawnLocation") and (spawn.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude < 100 then
                return spawn.CFrame
            end
        end
    end

    return nil
end

-- LOOP 1: AUTO COLETAR
task.spawn(function()
    while task.wait(0.4) do
        if Settings.AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoCollect then break end
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        local parentName = parent and parent.Name or ""
                        
                        if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or prompt.Name:find("Wood") then
                            local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position - hrp.Position).Magnitude <= 20 then
                                TriggerPrompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- LOOP 2: AUTO VENDER COM TELEPORTE
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoSell then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local baseCF = GetMyBaseCFrame()
                if baseCF then
                    -- Teleporta para a base encontrada ou configurada
                    hrp.CFrame = baseCF + Vector3.new(0, 4, 0)
                    task.wait(0.3)

                    -- Ativa os prompts da serraria
                    for _, prompt in ipairs(Workspace:GetDescendants()) do
                        if not Settings.AutoSell then break end
                        if prompt:IsA("ProximityPrompt") then
                            local name = prompt.Name:lower()
                            local pName = (prompt.Parent and prompt.Parent.Name or ""):lower()
                            if name:find("sell") or pName:find("sell") or name:find("chipper") or pName:find("chipper") or name:find("deposit") or pName:find("saw") then
                                TriggerPrompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- LOOP 3: ALAVANCA
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever"))) then
                        TriggerPrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

