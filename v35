-- [[ PRISM HUB v3.5 - ULTRA-PROTECTED CYCLE ]]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Tratamento para remoção de UI antiga sem dar erro
pcall(function()
    if CoreGui:FindFirstChild("PrismHubUI") then
        CoreGui.PrismHubUI:Destroy()
    end
end)

local Settings = {
    AutoFarmLoop = false,
    LoopDelay = 3
}

local CustomBaseCFrame = nil
local LastWoodCFrame = nil

-- Função de Tecla com verificação de segurança estrita
local function PressKeyE()
    pcall(function()
        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    end)
end

-- CICLO PRINCIPAL TOTALMENTE BLINDADO COM PCALL
task.spawn(function()
    while true do
        if Settings.AutoFarmLoop then
            pcall(function()
                local char = LocalPlayer and LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and CustomBaseCFrame then
                    -- ETAPA 1: Salva o ponto atual
                    LastWoodCFrame = hrp.CFrame

                    -- ETAPA 2: Coleta por 3 segundos
                    local collectTimer = os.clock()
                    while os.clock() - collectTimer < 3 do
                        if not Settings.AutoFarmLoop then break end
                        PressKeyE()
                        task.wait(0.25)
                    end

                    -- ETAPA 3: Teleporta para a Base e Vende
                    if Settings.AutoFarmLoop then
                        hrp.CFrame = CustomBaseCFrame + Vector3.new(0, 3, 0)
                        task.wait(0.6)

                        local sellTimer = os.clock()
                        while os.clock() - sellTimer < 2 do
                            if not Settings.AutoFarmLoop then break end
                            PressKeyE()
                            task.wait(0.25)
                        end
                    end

                    -- ETAPA 4: Retorna para o local de corte
                    if Settings.AutoFarmLoop and LastWoodCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = LastWoodCFrame
                    end
                end
            end)
        end
        task.wait(Settings.LoopDelay)
    end
end)

-- CRIAÇÃO DA UI COM PROTEÇÃO CONTRA CoreGui
local function BuildUI()
    local success, result = pcall(function()
        local parentGui = CoreGui
        -- Se CoreGui for bloqueado pelo executador, usa PlayerGui como fallback
        if not pcall(function() return CoreGui.Name end) then
            parentGui = LocalPlayer:WaitForChild("PlayerGui")
        end

        local ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "PrismHubUI"
        ScreenGui.Parent = parentGui

        local MainFrame = Instance.new("Frame")
        MainFrame.Size = UDim2.new(0, 280, 0, 220)
        MainFrame.Position = UDim2.new(0.5, -140, 0.4, -110)
        MainFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        MainFrame.Active = true
        MainFrame.Draggable = true
        MainFrame.Parent = ScreenGui

        Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

        local Header = Instance.new("Frame")
        Header.Size = UDim2.new(1, 0, 0, 35)
        Header.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
        Header.Parent = MainFrame
        Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 8)

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(1, -40, 1, 0)
        Title.Position = UDim2.new(0, 10, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Text = "Prism Hub v3.5 - Protected"
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.Font = Enum.Font.SourceSansBold
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = Header

        local CloseBtn = Instance.new("TextButton")
        CloseBtn.Size = UDim2.new(0, 24, 0, 24)
        CloseBtn.Position = UDim2.new(1, -28, 0, 5)
        CloseBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        CloseBtn.Text = "X"
        CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        CloseBtn.Font = Enum.Font.SourceSansBold
        CloseBtn.Parent = Header
        Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)

        CloseBtn.MouseButton1Click:Connect(function()
            Settings.AutoFarmLoop = false
            ScreenGui:Destroy()
        end)

        local ContentFrame = Instance.new("Frame")
        ContentFrame.Size = UDim2.new(1, -16, 1, -45)
        ContentFrame.Position = UDim2.new(0, 8, 0, 40)
        ContentFrame.BackgroundTransparency = 1
        ContentFrame.Parent = MainFrame

        local Layout = Instance.new("UIListLayout")
        Layout.Parent = ContentFrame
        Layout.Padding = UDim.new(0, 8)

        local SetBaseBtn = Instance.new("TextButton")
        SetBaseBtn.Size = UDim2.new(1, 0, 0, 40)
        SetBaseBtn.BackgroundColor3 = Color3.fromRGB(70, 50, 120)
        SetBaseBtn.Text = "📍 1. Salvar Minha Posição Atual Como Base"
        SetBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SetBaseBtn.Font = Enum.Font.SourceSansBold
        SetBaseBtn.TextSize = 12
        SetBaseBtn.Parent = ContentFrame
        Instance.new("UICorner", SetBaseBtn).CornerRadius = UDim.new(0, 6)

        SetBaseBtn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                CustomBaseCFrame = char.HumanoidRootPart.CFrame
                SetBaseBtn.Text = "✅ Base Salva Com Sucesso!"
                SetBaseBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 70)
                task.wait(2)
                SetBaseBtn.Text = "📍 Atualizar Posição da Base"
            end
        end)

        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(1, 0, 0, 40)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
        ToggleBtn.Text = "2. Auto Ciclo [OFF]"
        ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        ToggleBtn.Font = Enum.Font.SourceSansSemibold
        ToggleBtn.TextSize = 12
        ToggleBtn.Parent = ContentFrame
        Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

        ToggleBtn.MouseButton1Click:Connect(function()
            if not CustomBaseCFrame then
                SetBaseBtn.Text = "⚠️ Salve a Base Primeiro!"
                task.wait(1.5)
                SetBaseBtn.Text = "📍 1. Salvar Minha Posição Atual Como Base"
                return
            end
            
            Settings.AutoFarmLoop = not Settings.AutoFarmLoop
            if Settings.AutoFarmLoop then
                ToggleBtn.Text = "2. Auto Ciclo [ON]"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
                ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                ToggleBtn.Text = "2. Auto Ciclo [OFF]"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
                ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end)
    end)
    
    if not success then
        warn("[PRISM HUB ERROR]: " .. tostring(result))
    end
end

BuildUI()
