-- [[ PRISM HUB v3.4 - NATIVE KEYBOARD E SIMULATION ]]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Limpeza da interface antiga
if CoreGui:FindFirstChild("PrismHubUI") then
    CoreGui.PrismHubUI:Destroy()
end

local Settings = {
    AutoFarmLoop = false,
    LoopDelay = 3
}

local CustomBaseCFrame = nil
local LastWoodCFrame = nil

-- Simula o pressionamento real da tecla "E" via teclado do sistema
local function PressKeyE()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- CICLO DE TELEPORTE COM PRESSIONAMENTO FÍSICO DA TECLA E
task.spawn(function()
    while true do
        if Settings.AutoFarmLoop then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and CustomBaseCFrame then
                    -- ETAPA 1: Salva o ponto atual de corte na floresta
                    LastWoodCFrame = hrp.CFrame

                    -- ETAPA 2: Simula o "E" na área de madeira por 3 segundos
                    local collectTimer = os.clock()
                    while os.clock() - collectTimer < 3 do
                        if not Settings.AutoFarmLoop then break end
                        PressKeyE()
                        task.wait(0.2)
                    end

                    -- ETAPA 3: Teleporta para a Base e Pressiona "E" para Vender
                    if Settings.AutoFarmLoop then
                        hrp.CFrame = CustomBaseCFrame + Vector3.new(0, 3, 0)
                        task.wait(0.5)

                        local sellTimer = os.clock()
                        while os.clock() - sellTimer < 2 do
                            if not Settings.AutoFarmLoop then break end
                            PressKeyE()
                            task.wait(0.2)
                        end
                    end

                    -- ETAPA 4: Retorna para o ponto de corte
                    if Settings.AutoFarmLoop and LastWoodCFrame then
                        hrp.CFrame = LastWoodCFrame
                    end
                end
            end)
        end
        task.wait(Settings.LoopDelay)
    end
end)

