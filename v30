    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0))
end)

local Settings = {
    AutoFarmLoop = false,
    AutoRollLever = false,
    NoClip = false,
    LoopDelay = 3 -- Tempo de espera (em segundos) entre os ciclos
}

local CustomBaseCFrame = nil
local LastWoodCFrame = nil

local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- LOOP DE CICLO COMPLETO (Coleta -> Vende -> Volta)
task.spawn(function()
    while true do
        if Settings.AutoFarmLoop then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and CustomBaseCFrame then
                    -- ETAPA 1: Salva o ponto atual da floresta/madeira
                    LastWoodCFrame = hrp.CFrame

                    -- ETAPA 2: Coleta madeiras ao redor por 3 segundos
                    local collectTimer = os.clock()
                    while os.clock() - collectTimer < 3 do
                        if not Settings.AutoFarmLoop then break end
                        for _, prompt in ipairs(Workspace:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                local parent = prompt.Parent
                                local parentName = parent and parent.Name or ""
                                if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or prompt.Name:find("Wood") then
                                    local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                                    if part and (part.Position - hrp.Position).Magnitude <= 22 then
                                        TriggerPrompt(prompt)
                                    end
                                end
                            end
                        end
                        task.wait(0.3)
                    end

                    -- ETAPA 3: Teleporta para a Base e Efetua a Venda
                    if Settings.AutoFarmLoop then
                        hrp.CFrame = CustomBaseCFrame + Vector3.new(0, 3, 0)
                        task.wait(0.5)

                        local sellTimer = os.clock()
                        while os.clock() - sellTimer < 2 do
                            if not Settings.AutoFarmLoop then break end
                            for _, prompt in ipairs(Workspace:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    local name = prompt.Name:lower()
                                    local pName = (prompt.Parent and prompt.Parent.Name or ""):lower()
                                    if name:find("sell") or pName:find("sell") or name:find("chipper") or pName:find("chipper") or name:find("saw") then
                                        TriggerPrompt(prompt)
                                    end
                                end
                            end
                            task.wait(0.3)
                        end
                    end

                    -- ETAPA 4: Retorna para o local de corte de madeira
                    if Settings.AutoFarmLoop and LastWoodCFrame then
                        hrp.CFrame = LastWoodCFrame
                    end
                end
            end)
        end
        -- Tick de descanso ajustável para evitar detecção
        task.wait(Settings.LoopDelay)
    end
end)

-- LOOP SECUNDÁRIO: ALAVANCA
task.spawn(function()
    while task.wait(1.5) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever"))) then
                        TriggerPrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

