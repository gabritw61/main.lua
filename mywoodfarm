-- 2. CONFIGURAÇÕES & ESTADOS
-- ====================================================================
local Settings = {
    AutoCollect = false,
    AutoChipper = false,
    AutoRollLever = false,
    AutoBuyStumps = false,
    AutoBuyAxes = false,
    NoClip = false
}

-- ====================================================================
-- 3. FUNÇÕES DE AUTOMAÇÃO OTIMIZADAS (SEM TRAVAR O JOGO)
-- ====================================================================
local function FirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- Auto Coleta (Com delay de segurança para não travar a física do jogo)
task.spawn(function()
    while task.wait(0.8) do
        if Settings.AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if not Settings.AutoCollect then break end
                        if (obj.Name:find("Log") or obj.Name:find("Wood")) and obj:IsA("BasePart") then
                            if (obj.Position - hrp.Position).Magnitude < 35 then
                                firetouchinterest(hrp, obj, 0)
                                task.wait(0.05)
                                firetouchinterest(hrp, obj, 1)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Auto Processador (Chipper)
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoChipper then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoChipper then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Chipper") or (prompt.Parent and prompt.Parent.Name:find("Chipper"))) then
                        FirePrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- Auto Alavanca
task.spawn(function()
    while task.wait(1.5) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever"))) then
                        FirePrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- Auto Compras
task.spawn(function()
    while task.wait(2) do
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
            if remotes then
                if Settings.AutoBuyStumps and remotes:FindFirstChild("BuyStump") then
                    remotes.BuyStump:FireServer()
                end
                if Settings.AutoBuyAxes and remotes:FindFirstChild("BuyAxe") then
                    remotes.BuyAxe:FireServer()
                end
            end
        end)
    end
end)

-- NoClip Seguro (Sem quebrar o modelo do jogador)
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

