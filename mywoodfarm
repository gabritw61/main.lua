local function CreateButton(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0.9, 0, 0, 35)
    Btn.Position = UDim2.new(0.05, 0, 0, 0)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    Btn.Font = Enum.Font.SourceSans
    Btn.TextSize = 14
    Btn.Parent = MainFrame

    local enabled = false
    Btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        Btn.BackgroundColor3 = enabled and Color3.fromRGB(60, 120, 60) or Color3.fromRGB(45, 45, 60)
        callback(enabled)
    end)
end

-- Botões de Controle
CreateButton("Auto Collect & Sell Wood", function(state) AutoFarm = state end)
CreateButton("Auto Chipper / Collect", function(state) AutoChipper = state end)
CreateButton("Auto Roll Lever", function(state) AutoRollLever = state end)
CreateButton("Toggle NoClip", function(state) NoClipEnabled = state end)

CreateButton("Speed Hack (2x)", function(state)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = state and 32 or 16
    end
end)

