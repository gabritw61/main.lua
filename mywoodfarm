-- [[ Prism Hub v2.1 - Standalone Version ]]
-- Carregamento e inicialização segura de ambiente
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Prevenção Anti-AFK integrada
local VirtualUser = game:GetService("VirtualUser")
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0))
end)

-- Módulos de Mobilidade (Fly / Speed / NoClip)
local FlySpeed = 50
local Flying = false
local WalkSpeedValue = 16
local JumpPowerValue = 50
local NoClipEnabled = false

RunService.Stepped:Connect(function()
    if NoClipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Sistema de Automação (Farm & Logistics)
local AutoFarm = false
local AutoChipper = false
local AutoBuyStumps = false
local AutoBuyAxes = false
local AutoRollLever = false

local function SafeFirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        fireproximityprompt(prompt)
    end
end

-- Loop de Automação Principal
task.spawn(function()
    while task.wait(0.5) do
        if AutoFarm then
            pcall(function()
                -- Interação com toras e itens da parcela
                for _, item in ipairs(workspace:GetDescendants()) do
                    if item.Name == "WoodLog" or item.Name == "WoodItem" then
                        if item:FindFirstChild("TouchInterest") then
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, item, 0)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, item, 1)
                        end
                    end
                end
            end)
        end

        if AutoChipper then
            pcall(function()
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt.Name == "ChipperPrompt" or prompt.Parent.Name == "Chipper" then
                        SafeFirePrompt(prompt)
                    end
                end
            end)
        end

        if AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt.Name == "LeverPrompt" then
                        SafeFirePrompt(prompt)
                    end
                end
            end)
        end
    end
end)

