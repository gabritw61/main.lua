end)

local Settings = {
    AutoFarmFull = false,
    AutoChipper = false,
    AutoRollLever = false,
    NoClip = false
}

-- Função segura para simular o pressionamento da tecla "E"
local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- Loop Principal de Automação (Coleta + Venda/Processamento na Serraria)
task.spawn(function()
    while task.wait(0.5) do
        if Settings.AutoFarmFull then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                -- 1. BUSCA E COLETA MADEIRA PRÓXIMA (Pressiona "E")
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoFarmFull then break end
                    if obj:IsA("ProximityPrompt") then
                        local parentName = obj.Parent and obj.Parent.Name or ""
                        if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or obj.Name:find("Wood") then
                            local part = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position - hrp.Position).Magnitude <= (obj.MaxActivationDistance or 25) then
                                TriggerPrompt(obj)
                                task.wait(0.2)
                            end
                        end
                    end
                end

                -- 2. VAI ATÉ A SERRARIA / PROCESSADOR E PRESSIONA "E" PARA VENDER
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoFarmFull then break end
                    if prompt:IsA("ProximityPrompt") then
                        local pName = prompt.Name
                        local parentName = prompt.Parent and prompt.Parent.Name or ""

                        -- Procura por gatilhos de Venda, Serraria ou Processador (Sawmill / Sell / Chipper)
                        if pName:find("Sell") or parentName:find("Sell") or pName:find("Saw") or parentName:find("Saw") or pName:find("Chipper") or parentName:find("Chipper") then
                            TriggerPrompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)

-- Loop Secundário (Alavanca/Rolls isolados)
task.spawn(function()
    while task.wait(0.8) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") then
                        if prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever")) then
                            TriggerPrompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

