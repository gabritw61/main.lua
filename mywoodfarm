-- 2. ESTADOS DA AUTOMAÇÃO
-- ====================================================================
local Settings = {
    AutoCollect = false,
    AutoSell = false,
    AutoChipper = false,
    AutoRollLever = false,
    AutoBuyStumps = false,
    AutoBuyAxes = false,
    WalkSpeed = 16,
    JumpPower = 50,
    NoClip = false
}

-- ====================================================================
-- 3. ENCONTRAR A PARCELA (PLOT) DO JOGADOR
-- ====================================================================
local function GetMyPlot()
    if Workspace:FindFirstChild("Plots") then
        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            if plot:FindFirstChild("Owner") and plot.Owner.Value == LocalPlayer then
                return plot
            end
        end
    end
    return nil
end

-- ====================================================================
-- 4. FUNÇÕES DE AUTOMAÇÃO
-- ====================================================================

-- Disparador universal de gatilhos (ProximityPrompt)
local function FirePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        fireproximityprompt(prompt)
    end
end

-- Auto Coleta de Madeira/Toras
task.spawn(function()
    while task.wait(0.3) do
        if Settings.AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if (obj.Name:find("Log") or obj.Name:find("Wood") or obj.Name:find("Tree")) and obj:IsA("BasePart") then
                            if (obj.Position - char.HumanoidRootPart.Position).Magnitude < 50 then
                                firetouchinterest(char.HumanoidRootPart, obj, 0)
                                firetouchinterest(char.HumanoidRootPart, obj, 1)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Auto Picotador / Processador (Chipper)
task.spawn(function()
    while task.wait(0.5) do
        if Settings.AutoChipper then
            pcall(function()
                local myPlot = GetMyPlot()
                local targetParent = myPlot or Workspace
                for _, prompt in ipairs(targetParent:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and (prompt.Parent.Name:find("Chipper") or prompt.Name:find("Chipper")) then
                        FirePrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- Auto Alavanca / Roleta (Lever Roll)
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or prompt.Parent.Name:find("Lever")) then
                        FirePrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- Auto Compras (Tocos e Machados)
task.spawn(function()
    while task.wait(1.5) do
        pcall(function()
            if Settings.AutoBuyStumps or Settings.AutoBuyAxes then
                -- Varre eventos remotos de compra conhecidos no jogo
                local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
                if remotes then
                    if Settings.AutoBuyStumps and remotes:FindFirstChild("BuyStump") then
                        remotes.BuyStump:FireServer()
                    end
                    if Settings.AutoBuyAxes and remotes:FindFirstChild("BuyAxe") then
                        remotes.BuyAxe:FireServer()
                    end
                end
            end
        end)
    end
end)

-- ====================================================================
-- 5. FUNÇÕES DE MOBILIDADE (NOCLIP & MOVEMENT)
-- ====================================================================
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

