local Settings = {
    AutoCollect = false,
    AutoSell = false,
    AutoRollLever = false,
    NoClip = false
}

local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- ENCONTRAR APENAS A SUA PARCELA/BASE (MY PLOT)
local function GetMyBasePlot()
    if Workspace:FindFirstChild("Plots") then
        for _, plot in ipairs(Workspace.Plots:GetChildren()) do
            -- Verifica se o dono do Plot é o LocalPlayer
            local owner = plot:FindFirstChild("Owner") or plot:FindFirstChild("OwnerValue")
            if owner and (owner.Value == LocalPlayer or owner.Value == LocalPlayer.Name) then
                return plot
            end
        end
    end
    -- Busca alternativa pelo mapa
    for _, plot in ipairs(Workspace:GetChildren()) do
        if plot.Name:find("Plot") or plot.Name:find("Land") then
            local owner = plot:FindFirstChild("Owner")
            if owner and owner.Value == LocalPlayer then
                return plot
            end
        end
    end
    return nil
end

-- ENCONTRAR O PONTO DE VENDA DENTRO DA SUA BASE
local function GetMySellCFrame()
    local myPlot = GetMyBasePlot()
    if myPlot then
        for _, obj in ipairs(myPlot:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("sell") or name:find("chipper") or name:find("sawmill") or name:find("deposit") or name:find("collector") then
                if obj:IsA("BasePart") then
                    return obj.CFrame
                elseif obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
                    return obj.Parent.CFrame
                end
            end
        end
        -- Se não achar ponto com nome específico, pega a parte principal do plot
        if myPlot:IsA("BasePart") then return myPlot.CFrame end
    end
    return nil
end

-- LOOP 1: AUTO COLETAR MADEIRA
task.spawn(function()
    while task.wait(0.4) do
        if Settings.AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoCollect then break end
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        local parentName = parent and parent.Name or ""
                        
                        if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or prompt.Name:find("Wood") then
                            local part = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position - hrp.Position).Magnitude <= 20 then
                                TriggerPrompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- LOOP 2: AUTO VENDER (TELEPORTA APENAS PARA A SUA BASE E DISPARA "E")
task.spawn(function()
    while task.wait(0.8) do
        if Settings.AutoSell then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local mySellCFrame = GetMySellCFrame()
                if mySellCFrame then
                    -- Teleporta para a SUA serraria
                    hrp.CFrame = mySellCFrame + Vector3.new(0, 3, 0)
                    task.wait(0.2)

                    -- Dispara apenas prompts na SUA base
                    local myPlot = GetMyBasePlot()
                    local searchArea = myPlot or Workspace
                    for _, prompt in ipairs(searchArea:GetDescendants()) do
                        if not Settings.AutoSell then break end
                        if prompt:IsA("ProximityPrompt") then
                            TriggerPrompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)

-- LOOP 3: ALAVANCA
task.spawn(function()
    while task.wait(1) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever"))) then
                        TriggerPrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

