local Settings = {
    AutoFarmFull = false,
    AutoRollLever = false,
    NoClip = false
}

-- Função para encontrar a zona de venda (Plot / Sell Area)
local function GetSellTarget()
    -- Tenta encontrar a área de venda no mapa
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:find("Sell") or obj.Name:find("Collector") or obj.Name:find("Dump") then
            if obj:IsA("BasePart") then
                return obj
            end
        end
    end
    return nil
end

-- Simular Tecla "E"
local function TriggerPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end
end

-- LOOP PRINCIPAL: Coletar e Vender
task.spawn(function()
    while task.wait(0.3) do
        if Settings.AutoFarmFull then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local sellZone = GetSellTarget()

                -- 1. Coletar Madeiras Próximas via ProximityPrompt
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoFarmFull then break end
                    if obj:IsA("ProximityPrompt") then
                        local parentName = obj.Parent and obj.Parent.Name or ""
                        if parentName:find("Wood") or parentName:find("Log") or parentName:find("Tree") or obj.Name:find("Wood") then
                            local part = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                            if part and (part.Position - hrp.Position).Magnitude <= 25 then
                                TriggerPrompt(obj)
                            end
                        end
                    end
                end

                -- 2. Vender Madeiras no Chão / Inventário
                -- Move as peças de madeira diretamente para o ponto de venda do terreno
                for _, log in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoFarmFull then break end
                    if (log.Name:find("Log") or log.Name:find("Wood")) and log:IsA("BasePart") then
                        if sellZone then
                            log.CFrame = sellZone.CFrame
                        end
                        if log:FindFirstChildOfClass("TouchTransmitter") or log:FindFirstChild("TouchInterest") then
                            firetouchinterest(hrp, log, 0)
                            task.wait(0.02)
                            firetouchinterest(hrp, log, 1)
                        end
                    end
                end

                -- 3. Dispara os eventos remotos de venda de emergência
                local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
                if remotes then
                    for _, remote in ipairs(remotes:GetChildren()) do
                        if remote.Name:find("Sell") then
                            remote:FireServer()
                        end
                    end
                end
            end)
        end
    end
end)

-- Loop da Alavanca / Roleta
task.spawn(function()
    while task.wait(0.8) do
        if Settings.AutoRollLever then
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not Settings.AutoRollLever then break end
                    if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Lever") or (prompt.Parent and prompt.Parent.Name:find("Lever"))) then
                        TriggerPrompt(prompt)
                    end
                end
            end)
        end
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if Settings.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

